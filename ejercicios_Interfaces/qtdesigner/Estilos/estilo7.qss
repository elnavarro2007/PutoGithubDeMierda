
QPushButton:hover{
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    border-color: white;
    font-weight: bold;
    background-color: white;
    color: black;

}


QPushButton:on{
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    border-color: red;
    font-weight: bold;
    background-color: red;
    color: black;
    
}

QPushButton{
    background-color: blue;
    color: black;
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    font-weight: bold;
    border-color: blue;
}

