
QPushButton{
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    border-color: black;
    font-weight: bold;
    background-color: white;
    color: black;

}

QLabel{
    background-color: white;
    color: black;
}


QPushButton[text="+"] {
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    border-color: black;
    background-color: blue;
    font-weight: bold;
    color:white;

}

QPushButton[text="CE"] {
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    border-color: black;
    background-color: blue;
    font-weight: bold;
    color: white;
}


QPushButton[text="="] {
    border-radius: 5px;
    border-style: solid;
    border-width: 5px;
    border-color: black;
    background-color: blue;
    font-weight: bold;
    color: white;
}

.QWidget{
    background-color: grey;
}